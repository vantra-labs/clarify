#include <windows.h>

// Манифест (asInvoker + DPI) и иконка вшиты в сам exe: установщик должен
// выглядеть как приложение Clarify ещё в проводнике, до первого запуска.
1 RT_MANIFEST "bootstrap.manifest"
1 ICON "setup_icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "NovaMind Labs"
            VALUE "FileDescription", "Установка Clarify"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "Clarify_Setup"
            VALUE "LegalCopyright", "Copyright (C) 2026 NovaMind Labs"
            VALUE "OriginalFilename", "Clarify_Setup.exe"
            VALUE "ProductName", "Clarify"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
